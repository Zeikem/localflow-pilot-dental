APP_ENV=development
DATABASE_URL=postgresql+psycopg://localflow:localflow@db:5432/localflow
AUTO_CREATE_SCHEMA=true

WHATSAPP_VERIFY_TOKEN=cambia-este-token
WHATSAPP_APP_SECRET=cambia-este-app-secret
META_GRAPH_API_VERSION=v26.0

# Cada tenant referencia la variable que contiene su token.
DENTAL_DEMO_WHATSAPP_TOKEN=
OPTICA_DEMO_WHATSAPP_TOKEN=
FISIO_DEMO_WHATSAPP_TOKEN=

# Token largo y aleatorio para operaciones internas (/admin).
ADMIN_API_TOKEN=

# Google Calendar (solo si un tenant usa provider=google_calendar)
# JSON completo de una service account; en producción usa un secret manager.
DENTAL_GOOGLE_SERVICE_ACCOUNT_JSON=
DENTAL_GOOGLE_DELEGATED_SUBJECT=
DENTAL_GOOGLE_CALENDAR_ID=
DENTAL_GOOGLE_WHATSAPP_TOKEN=
